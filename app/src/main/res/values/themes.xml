<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A bare starting window. The activity calls enableEdgeToEdge() and Compose paints the real
      background, so this only has to avoid a white flash: it is transparent with no action bar.
    -->
    <style name="Theme.Youniversal.Demo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
